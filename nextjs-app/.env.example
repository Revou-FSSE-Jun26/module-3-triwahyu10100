# URL dasar backend Flask. Diakses lewat process.env.NEXT_PUBLIC_API_BASE_URL
# di semua pemanggilan API server-side — jangan hardcode URL di tempat lain.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# HARUS sama persis dengan JWT_SECRET_KEY di backend/.env — dipakai
# lib/require-admin.ts untuk memverifikasi signature JWT secara
# kriptografis sebelum mengizinkan mutasi produk/kategori lewat
# dashboard admin. Server-only, tidak pernah dikirim ke browser.
#
# Nilai default backend/.env saat ini (jawaban temuan iterasi 2 NIT #4
# — dikonfirmasi langsung dari backend/.env dan fallback-nya di
# backend/config.py) adalah persis string di bawah ini; isi
# JWT_SECRET_KEY= di nextjs-app/.env.local (BUKAN file .env.example
# ini) dengan nilai yang sama dengan apa yang sesungguhnya dipakai
# backend/.env lokal milikmu, kalau sudah diubah dari default:
# dev-jwt-secret-key-change-in-production
JWT_SECRET_KEY=
