# URL dasar backend Flask. Diakses lewat process.env.NEXT_PUBLIC_API_BASE_URL
# di semua pemanggilan API — jangan hardcode URL di tempat lain.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Kredensial akun demo untuk halaman /orders (lihat lib/demo-auth.ts).
# SENGAJA tidak diberi prefix NEXT_PUBLIC_ karena hanya dipakai di sisi
# server — nilainya tidak pernah dikirim ke browser. Daftarkan akun ini
# dulu lewat POST /users sebelum mengisi nilai asli di .env.local.
DEMO_USER_EMAIL=
DEMO_USER_PASSWORD=
